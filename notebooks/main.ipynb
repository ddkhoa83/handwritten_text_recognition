    "from sklearn.metrics import classification_report\n",
    "nb_model = NaiveBayes(log_pdf = gaussian_log_pdf)\n",
    "# train the model\n",
    "nb_model.fit(X_train_scaled, y_train)\n",
    "nb_y_pred = nb_model.predict(X_test_scaled)\n",
    "print(\"Đã huấn luyện mô hình Naive Bayes thành công!\")\n",
    "\n",
    "print(\"Classification Report:\")\n",
    "print(classification_report(y_test, nb_y_pred, target_names= nb_model.classes.astype(str)))"
