     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Số chiều:  10 | Accuracy: 76.33%\n",
      "Số chiều:  30 | Accuracy: 85.69%\n",
      "Số chiều:  50 | Accuracy: 87.09%\n",
      "Số chiều: 100 | Accuracy: 86.96%\n",
      "Số chiều: 150 | Accuracy: 85.66%\n",
      "Số chiều: 200 | Accuracy: 84.70%\n",
      "Số chiều: 300 | Accuracy: 81.96%\n"
     ]
