    "from src.algorithm.MLP import MLP\n",
    "\n",
    "mlp_model = MLP(n_epochs=30, momentum= 0.9, weight_decay= 0.0001, learning_rate= 0.1)\n",
    "\n",
    "mlp_model.fit(X_train_scaled, y_train, X_val_scaled, y_val)\n",
    "\n",
    "mlp_y_pred = mlp_model.predict(X_test_scaled)\n",
    "\n",
    "y_test = np.asarray(y_test)\n",
    "accuracy = np.mean(mlp_y_pred == y_test)\n",
    "\n",
    "MLP.plot_history({\"Baseline 784-256-128-10\": mlp_model.history_}, \"Baseline 784-256-128-10\")\n",
